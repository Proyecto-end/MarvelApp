<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PerfilFragment"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@android:color/system_accent2_900"
    >


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="19 Años"
        android:textSize="20dp"
        android:layout_gravity="center"
        android:background="@android:color/system_accent1_600"
        android:textColor="@color/black"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Joel Barriosnuevo"
        android:textSize="20dp"
        android:background="@android:color/system_accent3_500"
        android:textColor="@color/black"
        android:textStyle="bold"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JoelBarriosnuevo@gmail.com"
        android:textSize="20dp"
        android:layout_gravity="bottom"
        android:textColor="@color/black"
        android:textStyle="italic"
        android:background="@android:color/system_error_500"
        />




</FrameLayout>