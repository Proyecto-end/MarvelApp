<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/marvel_black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/marvel_medium_gray"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/marvel_purple"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_comic"
                    android:tint="@color/marvel_purple" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="SOLICITAR COMIC"
                    android:textColor="@color/marvel_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Selecciona tu comic favorito de Marvel"
                    android:textColor="@color/marvel_medium_text"
                    android:textSize="16sp"
                    android:gravity="center" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/marvel_medium_gray"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/marvel_light_gray"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Título del formulario -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información de la solicitud"
                    android:textColor="@color/marvel_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Spinner de Comics -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar Comic *"
                    android:textColor="@color/marvel_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/marvel_light_gray"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerComics"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@android:color/transparent"
                        android:dropDownSelector="@color/marvel_red"
                        android:popupBackground="@color/marvel_medium_gray" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Cantidad -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCantidad"
                    style="@style/Widget.MarvelApp.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Cantidad"
                    app:startIconDrawable="@drawable/ic_numbers"
                    app:startIconTint="@color/marvel_purple">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCantidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="1"
                        android:textColor="@color/marvel_white"
                        android:textColorHint="@color/marvel_medium_text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Motivo de la solicitud -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMotivo"
                    style="@style/Widget.MarvelApp.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Motivo de la solicitud (opcional)"
                    app:startIconDrawable="@drawable/ic_edit"
                    app:startIconTint="@color/marvel_purple">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMotivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:gravity="top"
                        android:textColor="@color/marvel_white"
                        android:textColorHint="@color/marvel_medium_text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Prioridad -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prioridad"
                    android:textColor="@color/marvel_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgPrioridad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <RadioButton
                        android:id="@+id/rbBaja"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Baja"
                        android:textColor="@color/marvel_light_text"
                        android:buttonTint="@color/marvel_success"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbMedia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Media"
                        android:textColor="@color/marvel_light_text"
                        android:buttonTint="@color/marvel_warning" />

                    <RadioButton
                        android:id="@+id/rbAlta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Alta"
                        android:textColor="@color/marvel_light_text"
                        android:buttonTint="@color/marvel_error" />

                </RadioGroup>

                <!-- Mensaje de Error -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/marvel_error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Botón Solicitar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSolicitar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="ENVIAR SOLICITUD"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/marvel_purple"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconTint="@color/marvel_white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Comic Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/marvel_medium_gray"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/marvel_gold"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardForm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vista previa del comic"
                    android:textColor="@color/marvel_gold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivComicPreview"
                        android:layout_width="80dp"
                        android:layout_height="120dp"
                        android:background="@color/marvel_light_gray"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvComicTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/marvel_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Amazing Spider-Man #1" />

                        <TextView
                            android:id="@+id/tvComicDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/marvel_light_text"
                            android:textSize="14sp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            tools:text="La primera aparición del Hombre Araña en una aventura increíble..." />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Loading Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loadingAnimation"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btnSolicitar"
            app:layout_constraintEnd_toEndOf="@id/btnSolicitar"
            app:layout_constraintStart_toStartOf="@id/btnSolicitar"
            app:layout_constraintTop_toTopOf="@id/btnSolicitar"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_animation" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView> 