<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para TextInputLayout -->
    <style name="Widget.MarvelApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/marvel_red</item>
        <item name="hintTextColor">@color/marvel_medium_text</item>
        <item name="android:textColorHint">@color/marvel_medium_text</item>
        <item name="android:textColor">@color/marvel_white</item>
        <item name="boxBackgroundColor">@color/marvel_dark_gray</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- Estilo para TextInputLayout Mejorado -->
    <style name="Widget.MarvelApp.TextInputLayout.Enhanced" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/marvel_red</item>
        <item name="hintTextColor">@color/marvel_blue</item>
        <item name="android:textColorHint">@color/marvel_medium_text</item>
        <item name="android:textColor">@color/marvel_white</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
    </style>

    <!-- Estilo para Toolbar -->
    <style name="Widget.MarvelApp.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="android:background">@color/marvel_toolbar</item>
        <item name="android:textColorPrimary">@color/marvel_white</item>
        <item name="android:textColorSecondary">@color/marvel_light_gray</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.MarvelApp.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/marvel_dark_gray</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemRippleColor">@color/marvel_red</item>
    </style>
</resources> 