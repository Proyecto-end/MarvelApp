<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NavegationButton" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.NavegationButton" parent="Base.Theme.NavegationButton" />

    <!-- Tema principal de Marvel -->
    <style name="Theme.MarvelStudios" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/marvel_red</item>
        <item name="colorPrimaryVariant">@color/marvel_red_dark</item>
        <item name="colorOnPrimary">@color/marvel_white</item>
        
        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/marvel_blue</item>
        <item name="colorSecondaryVariant">@color/marvel_blue_dark</item>
        <item name="colorOnSecondary">@color/marvel_white</item>
        
        <!-- Colores de fondo -->
        <item name="android:colorBackground">@color/marvel_black</item>
        <item name="colorSurface">@color/marvel_dark_gray</item>
        <item name="colorOnBackground">@color/marvel_white</item>
        <item name="colorOnSurface">@color/marvel_white</item>
        
        <!-- Colores de error -->
        <item name="colorError">@color/marvel_error</item>
        <item name="colorOnError">@color/marvel_white</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/marvel_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/marvel_black</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/marvel_black</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/marvel_white</item>
        <item name="android:textColorSecondary">@color/marvel_light_gray</item>
        <item name="android:textColorHint">@color/marvel_gray</item>
        
        <!-- Accent color -->
        <item name="colorAccent">@color/marvel_accent</item>
    </style>
    
    <!-- Tema para la toolbar -->
    <style name="Theme.MarvelStudios.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorPrimary">@color/marvel_toolbar</item>
        <item name="colorOnPrimary">@color/marvel_white</item>
        <item name="android:textColorPrimary">@color/marvel_white</item>
    </style>
    
    <!-- Tema para botones primarios -->
    <style name="Theme.MarvelStudios.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/marvel_red</item>
        <item name="android:textColor">@color/marvel_white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Tema para botones secundarios -->
    <style name="Theme.MarvelStudios.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/marvel_blue</item>
        <item name="android:textColor">@color/marvel_blue</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Tema para EditText -->
    <style name="Theme.MarvelStudios.EditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/marvel_red</item>
        <item name="hintTextColor">@color/marvel_gray</item>
        <item name="android:textColor">@color/marvel_white</item>
        <item name="android:textColorHint">@color/marvel_gray</item>
    </style>
    
    <!-- Tema para CardView -->
    <style name="Theme.MarvelStudios.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/marvel_card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>
    
    <!-- Tema para Bottom Navigation -->
    <style name="Theme.MarvelStudios.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/marvel_toolbar</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemRippleColor">@color/marvel_ripple</item>
    </style>
    
    <!-- Tema para Chips -->
    <style name="Theme.MarvelStudios.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/marvel_blue</item>
        <item name="android:textColor">@color/marvel_white</item>
        <item name="chipStrokeColor">@color/marvel_blue_dark</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
    </style>
    
    <!-- Tema para diálogos -->
    <style name="Theme.MarvelStudios.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:colorBackground">@color/marvel_dark_gray</item>
        <item name="colorSurface">@color/marvel_dark_gray</item>
        <item name="android:textColorPrimary">@color/marvel_white</item>
        <item name="colorPrimary">@color/marvel_red</item>
    </style>
    
    <!-- Tema para Spinner -->
    <style name="Theme.MarvelStudios.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/edittext_background</item>
        <item name="android:textColor">@color/marvel_white</item>
        <item name="android:textColorHint">@color/marvel_gray</item>
    </style>
    
    <!-- Tema para RadioButton -->
    <style name="Theme.MarvelStudios.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/marvel_red</item>
        <item name="android:textColor">@color/marvel_white</item>
    </style>
    
    <!-- Tema para CheckBox -->
    <style name="Theme.MarvelStudios.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/marvel_red</item>
        <item name="android:textColor">@color/marvel_white</item>
    </style>
    
    <!-- Tema para Switch -->
    <style name="Theme.MarvelStudios.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/marvel_red</item>
        <item name="trackTint">@color/marvel_gray</item>
        <item name="android:textColor">@color/marvel_white</item>
    </style>
    
    <!-- Tema para ProgressBar -->
    <style name="Theme.MarvelStudios.ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/marvel_red</item>
    </style>
    
</resources>