<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_gradient">

        <!-- Imagen circular -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/heroImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:contentDescription="Imagen del superhéroe"
            android:layout_gravity="center_vertical" />

        <!-- Contenido -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="20dp">

            <TextView
                android:id="@+id/heroName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/marvel_white"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/tvUniverso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/marvel_light_text"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/heroDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/marvel_medium_text"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Fila inferior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <!-- Estado -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/estadoPunto"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circle_estado"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activo"
                        android:textColor="@color/marvel_white"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Popularidad -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_star"
                        android:tint="@color/marvel_gold"/>
                    <TextView
                        android:id="@+id/tvPopularidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/marvel_gold"
                        android:textSize="13sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <!-- Comics -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_comic"
                        android:tint="@color/marvel_white"/>
                    <TextView
                        android:id="@+id/tvComics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 comics"
                        android:textColor="@color/marvel_white"
                        android:textSize="13sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <!-- Espaciador para alinear el botón a la derecha -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Botón Ver Más -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerMas"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Ver más"
                    android:textColor="@color/marvel_dark_red"
                    android:textSize="13sp"
                    app:backgroundTint="@color/marvel_white"
                    app:cornerRadius="16dp"
                    android:layout_gravity="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>